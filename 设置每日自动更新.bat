@echo off
chcp 936 >nul
cd /d "%~dp0"
title 彩票统计 - 设置每日自动更新

echo ============================================
echo   注册 Windows 计划任务：每天自动刷新并推送
echo ============================================
echo.
echo 说明：GitHub 的服务器在境外，彩票官方接口会拒绝它的请求
echo       （403/567），所以自动更新必须跑在你这台国内网络的
echo       电脑上。设置后每天 21:50 自动执行（需电脑开机）。
echo.
set /p TT=请输入每天执行的时间（24小时制，如 21:50，直接回车用 21:50）:
if "%TT%"=="" set TT=21:50

schtasks /create /tn "彩票统计每日更新" /tr "\"%~dp0一键更新并推送.bat\"" /sc daily /st %TT% /f
if errorlevel 1 (
  echo.
  echo [失败] 创建计划任务失败，请以管理员身份运行本脚本。
  pause
  exit /b 1
)

echo.
echo --------------------------------------------
echo 已创建计划任务「彩票统计每日更新」，每天 %TT% 执行。
echo 可在 任务计划程序 中查看/修改/删除。
echo --------------------------------------------
echo.
pause
